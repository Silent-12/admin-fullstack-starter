# ==================== 应用配置 ====================
# 运行环境（development | test | production）
NODE_ENV=development
# 应用服务端口
PORT=3000
# API 路由前缀
API_PREFIX=backend

# 是否开启 Redis 限流策略（true | false）
THROTTLE_ENABLED=false
# Knife4j 文档 Basic Auth 开关（true | false）
KNIFE4J_AUTH_ENABLED=false
# Knife4j 文档 Basic Auth 用户名
KNIFE4J_USERNAME=example
# Knife4j 文档 Basic Auth 密码
KNIFE4J_PASSWORD=example-password
# 文件上传目录（支持相对路径或绝对路径）
UPLOAD_DIR=uploads


# ==================== HTTP 日志配置 ====================
# HTTP 请求日志开关（生产环境开启后可写入数据库）
HTTP_LOG_ENABLED=false


# ==================== 数据库配置 ====================
# 是否启用 MySQL 数据库（true | false）
MYSQL_ENABLED=false
# 数据库主机地址
DB_HOST=localhost
# 数据库端口号
DB_PORT=3306
# 数据库用户名
DB_USERNAME=root
# 数据库密码
DB_PASSWORD=root
# 数据库名称
DB_DATABASE=nestjs_demo
# 是否自动同步数据库表结构（生产环境禁止开启，开发环境可开启）
DB_SYNCHRONIZE=true
# 是否开启 SQL 执行日志（开发调试时可开启）
DB_LOGGING=false


# ==================== Redis 配置 ====================
# 是否启用 Redis（true | false）；后台认证依赖 Redis，MYSQL_ENABLED=true 时必须为 true
REDIS_ENABLED=false
# Redis 主机地址
REDIS_HOST=localhost
# Redis 端口号
REDIS_PORT=6379
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# Redis 数据库编号（0-15）
REDIS_DB=0

# ==================== 后台认证配置 ====================
# JWT 签名密钥：Base64 编码的随机值，解码后至少 32 字节；可用 node:crypto 的 randomBytes(48).toString('base64') 生成，禁止使用示例值
JWT_SECRET=replace-with-a-base64-encoded-random-secret
# 访问令牌有效期（秒），默认 30 天
JWT_EXPIRES_SECONDS=2592000
# 内置 admin 初始密码：仅首次执行 admin-init 时必填，12 至 128 位，不写入日志
ADMIN_INIT_PASSWORD=
