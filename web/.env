# 【通用】环境变量

# 应用名称
VITE_APP_NAME = Ao Design Pro

# 应用版本
VITE_APP_VERSION = 1.0.0

# 端口号
VITE_PORT = 3006

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# 跨域请求时是否携带 Cookie（开启前需确保后端支持）
VITE_WITH_CREDENTIALS = false

# 是否打开路由信息展示
VITE_OPEN_ROUTE_INFO = false

# 路由来源：dynamic 使用后端授权菜单，static 使用本地菜单调试
VITE_ROUTE_SOURCE = static
